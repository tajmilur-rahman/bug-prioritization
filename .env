# ===== Runtime device selection =====
# Try "gpu" first; fall back to cpu if not available
DEVICE=cpu
# Force CPU embedding service regardless of GPU presence
FORCE_CPU=false

# ===== Embedding service =====
EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMB_MAX_LEN=160
EMB_BATCH_SIZE_GPU=256
EMB_BATCH_SIZE_CPU=64
EMB_PORT=8001
EMB_URL=http://embeddings-svc:8001
ENC_VER=emb_v1

# Embedding behavior
MODE=local                        # http | local
EMBEDDINGS_ENDPOINT=http://embeddings-svc:8001
EMBED_MAX_SEQ_LEN=160
EMBED_LOCAL_BATCH=256
EMBED_HTTP_BATCH=512
EMBED_CACHE_DB=artifacts/emb_cache/embeddings.sqlite


# ===== Classifier service =====
CLF_PORT=8002
CLF_MODEL_A=artifacts/current_A/xgb.pkl
CLF_MODEL_B=artifacts/current_B/xgb.pkl

# ===== Topic modeling =====
TOPIC_MODE=centroid      # options: transform | centroid
TOPIC_CENTROIDS=artifacts/topics/topic_centroids.npy
TOPIC_MANIFEST=artifacts/topics/manifest.json

# ===== Data & artifacts =====
DATA_DIR=data
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# ===== Caching / storage =====
CACHE_DIR=.cache
VECTOR_STORE=faiss        # faiss | annoy | numpy
SQLITE_PATH=data/bugs.sqlite

# ===== Splits =====
VAL_FRAC=0.10
TEST_FRAC=0.10
TIME_COL=creation_time

# ===== Training params (overrides YAML if exported) =====
RANDOM_SEED=42
XGB_N_EST=400
XGB_MAX_DEPTH=6
XGB_LR=0.07

# ===== Dashboard =====
UI_PORT=8080

# ===== Misc =====
PYTHONHASHSEED=0
OMP_NUM_THREADS=8
