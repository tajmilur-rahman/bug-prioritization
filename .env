

# ===== Runtime device selection =====
# Try "gpu" first; fall back to cpu if not available (your launcher can implement the fallback)
DEVICE=cpu                 # {gpu|cpu}
FORCE_CPU=false            # if true, forces CPU for all steps even if GPU detected
OMP_NUM_THREADS=16         # align with boosters' CPU threads

# ===== Embedding service (local encoder or HTTP microservice) =====
MODE=local                 # {local|http}
EMB_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMB_MAX_LEN=160            # aligns with features.yaml truncate_tokens
EMB_LOCAL_BATCH=256
EMB_HTTP_BATCH=512
EMB_CACHE_DB=artifacts/emb_cache/embeddings.sqlite

# HTTP endpoint (used only when MODE=http)
EMB_URL=http://embeddings-svc:8001
EMB_PORT=8001
ENC_VER=emb_v1

# ===== Topic modeling (stable centroid-consistent by default) =====
TOPIC_MODE=centroid        # {centroid|transform}
TOPIC_CENTROIDS=artifacts/topics/topic_centroids.npy
TOPIC_MANIFEST=artifacts/topics/manifest.json

# ===== Data & artifacts =====
DATA_DIR=data
ARTIFACTS_DIR=artifacts
LOG_DIR=logs
CACHE_DIR=.cache
SQLITE_PATH=data/bugs.sqlite

# Preprocessing cache (shared across all algorithms)
PREP_CACHE_ROOT=artifacts/prep
# Optional explicit selection. If empty, the runner computes a prep_id from PCA/scaler/topic map.
PREP_ID=

# Cached matrices produced by the prep step (consumed by trainers/services)
X_TRAIN=artifacts/prep/${PREP_ID}/X_train.arrow
Y_TRAIN=artifacts/prep/${PREP_ID}/y_train.npy
X_VAL=artifacts/prep/${PREP_ID}/X_val.arrow
Y_VAL=artifacts/prep/${PREP_ID}/y_val.npy
X_TEST=artifacts/prep/${PREP_ID}/X_test.arrow
Y_TEST=artifacts/prep/${PREP_ID}/y_test.npy

# ===== Splits =====
# Keep time-based boundaries for drift evaluation.
# If your pipeline already persisted the split, VAL_FRAC/TEST_FRAC are ignored.
VAL_FRAC=0.10
TEST_FRAC=0.10
TIME_COL=creation_time

# Feature configuration
FEATURES_YAML=configs/features.yaml

# ===== Fusion & imbalance (runtime overrides for trainers) =====
FUSION=B1                  # {A1|A2|A3|A4|B1|B2}
#IMBALANCE=auto             # {auto|class_weight|weighted_ce|focal|cb_loss|smote_tomek|none}
IMBALANCE=weighted_ce
LA_TAU=1.0
FOCAL_GAMMA=1.5
CLASS_WEIGHT_CLIP_MIN=1.0
CLASS_WEIGHT_CLIP_MAX=8.0
AUTO_IMBAL_IR_MILD=3
AUTO_IMBAL_IR_MODERATE=8
MINORITY_MIN_SAMPLES=500


# ===== Algorithm selection & common knobs =====
ALGO=mlp               # {xgboost|lightgbm|catboost|mlp}
RANDOM_SEED=42
EPOCHS=140                 # used by MLP only
BATCH_SIZE=512             # used by MLP only
LR=0.0005                   # MLP
WEIGHT_DECAY=0.0010        # MLP
EARLY_STOP=60              # MLP patience
EARLY_STOP_MIN_DELTA=0.0001 # MLP

# ===== XGBoost defaults (match features.updated.yaml) =====
XGB_N_EST=1200
XGB_MAX_DEPTH=8
XGB_LR=0.05
XGB_SUBSAMPLE=0.8
XGB_COLSAMPLE=0.8
XGB_MAX_BIN=256
XGB_TREE_METHOD=hist       # {hist|gpu_hist}
XGB_GROW_POLICY=lossguide
XGB_THREADS=16
XGB_GPU=false

# ===== LightGBM defaults =====
LGBM_N_EST=2000
LGBM_NUM_LEAVES=64
LGBM_LR=0.05
LGBM_SUBSAMPLE=0.8
LGBM_COLSAMPLE=0.8
LGBM_MIN_CHILD_SAMPLES=20
LGBM_THREADS=16
LGBM_GPU=false
LGBM_IS_UNBALANCE=false

# ===== CatBoost defaults =====
CAT_ITER=2000
CAT_DEPTH=8
CAT_LR=0.05
CAT_L2=3.0
CAT_LOSS=MultiClass
CAT_THREADS=16
CAT_GPU=false

# ===== MLP defaults =====
MLP_HIDDEN=512,256
MLP_DROPOUT=0.45
MLP_ACT=gelu			        # (relu|gelu|silu|mish|tanh)
MLP_NORM=layernorm_per_block	# (none|layernorm_per_block|batchnorm_per_block|layernorm_input_output)
MLP_CALIBRATION_TEMP_SCALING=true

# MLP regularization 
MLP_DROPPATH=0.05                 # 0.0 (off), try 0.05–0.2 if ≥4 blocks
MLP_DROPPATH_SCHEDULE=linear     # {linear|constant}

# (Optional but handy for the improved trainer)
SCHEDULER=onecycle               # {onecycle|none}
AMP=true                         # mixed precision on GPU
GRAD_CLIP=1.0


# ===== Classifier service (if you deploy endpoints) =====
CLF_PORT=8002
CLF_MODEL_A=artifacts/current_A/xgb.pkl
CLF_MODEL_B=artifacts/current_B/xgb.pkl

# ===== Dashboard/UI =====
UI_PORT=8080

# ===== Misc =====
PYTHONHASHSEED=0
